# Copy to .env.production on the server and fill in. Never commit the real file.
# deploy/setup-ec2.sh generates JWT_SECRET and POSTGRES_PASSWORD for you.

# Public hostname Caddy serves (and gets an HTTPS certificate for).
# No domain? Use your Elastic IP with dashes + .sslip.io, e.g. 54-12-34-56.sslip.io
DOMAIN=

# Random secrets (openssl rand -hex 32)
JWT_SECRET=
POSTGRES_PASSWORD=

# Public demo: one-click "Try the demo" login + sample listings. Set both to false for a real USC-only launch.
DEMO_MODE=true
SEED_DEMO_DATA=true

# Optional features
# AI chatbot "Tommy Trojan" (free key at console.groq.com)
GROQ_API_KEY=
# Google Sign-In: add https://<DOMAIN> to the OAuth client's authorized JavaScript origins
GOOGLE_CLIENT_ID=
# AI-generated image detection on uploads (sightengine.com)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

JWT_EXPIRY=12h
LOG_MODE=basic
